# Deployment environment: development (default) or production.
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paper_agent
DATABASE_URL=postgresql://postgres:postgres@db:5432/paper_agent

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-nano
# Stronger model used by high-stakes tools (validate_references, humanize_text).
POWERFUL_MODEL=gpt-5.5
# Image model used to generate infographics (generate_infographic).
IMAGE_MODEL=gpt-image-1

# Crossref polite-pool contact (no API key needed). Use a real email so Crossref
# can reach you if your automated traffic ever misbehaves.
CROSSREF_MAILTO=you@example.com

# Elsevier (Scopus) Search API key — enables the search_scopus tool.
# Get one at https://dev.elsevier.com/. Optional; leave blank to disable the tool.
# Note: full Scopus results may require your institution's network/subscription.
ELSEVIER_API_KEY=your_elsevier_api_key_here

# OpenAlex API key — used by the search_openalex tool. Since 2026-02-13 OpenAlex
# requires a key for non-trivial use (free key grants $1 of usage/day; a few
# keyless calls still work for testing). Optional; get one at
# https://openalex.org/settings/api-key. Leave blank to run keyless.
OPENALEX_API_KEY=your_openalex_api_key_here

# Authentication (JWT) — CHANGE THIS to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: the account with this email is granted admin on startup (once it has
# registered). Order-independent and idempotent — use it instead of relying on
# "first to register becomes admin" for production. Leave unset to disable.
# ADMIN_EMAIL=you@example.com

# Human-in-the-loop. false (default) = the agent runs its whole plan and returns
# the final result. true = sensitive tools (analytics_sandbox, screen_abstracts_csv,
# ingest_pdf, draft_paper_section, compile_paper) pause for approve/edit/reject.
REQUIRE_TOOL_APPROVAL=false

# Per-user balance / usage billing. When ENABLE_BILLING=true (default) each chat
# turn deducts its measured token cost from the user's balance; a user at/below
# MIN_BALANCE_TO_CHAT is blocked until an admin tops them up. New accounts start
# with DEFAULT_USER_BALANCE dollars. COST_*_PER_1M are USD per 1,000,000 tokens.
# The first account to register is made admin automatically.
ENABLE_BILLING=true
DEFAULT_USER_BALANCE=0.5
MIN_BALANCE_TO_CHAT=0.0
COST_INPUT_PER_1M=0.15
COST_OUTPUT_PER_1M=0.60

# Agent guardrails. When true (default) every user message is screened (keyword
# rules + a cheap LLM classifier) before the agent runs; off-topic and
# jailbreak/system-abuse attempts are refused. GUARDRAIL_MODEL defaults to
# OPENAI_MODEL — keep it cheap, it runs on every message.
ENABLE_GUARDRAILS=true
# GUARDRAIL_MODEL=gpt-5.4-nano

# Provider PDF download queue. The provider serves full-text PDFs by DOI at
# {PROVIDER_BASE_URL}/article/doi?token=...&doi=... — PROVIDER_TOKEN is a BACKEND
# SECRET, only ever used server-side by the download worker; never expose it to
# the frontend. Leave PROVIDER_TOKEN unset to run without downloads.
PROVIDER_BASE_URL=http://provide.falinoos.ir:8081
# PROVIDER_TOKEN=your_provider_token_here
PROVIDER_TIMEOUT=60
# Per-user quota (retries don't consume quota; duplicate active DOIs dedupe).
DOWNLOAD_QUOTA_LIMIT=10
DOWNLOAD_QUOTA_WINDOW_HOURS=24
# Retry policy: 3 attempts, rescheduled 10 then 20 minutes after each 404 via a
# future available_at (the worker never sleeps for the delay).
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_DELAYS_MIN=10,20
# Requests 1-3 are FAST (target ~1h); 4-10 are STANDARD, spread across the next
# 24h at these hour offsets with ± deterministic per-user jitter.
FAST_TARGET_MINUTES=60
STANDARD_TARGET_HOURS=24
STANDARD_OFFSETS_HOURS=1,5,9,12,16,20,24
SCHEDULE_JITTER_MINUTES=15
# Anti-starvation + urgency knobs for the fair scheduler.
FAST_BEFORE_STANDARD=5
DEADLINE_URGENT_MINUTES=10
WORKER_POLL_SECONDS=5
ENABLE_DOWNLOAD_WORKER=true

# LangSmith Configuration
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=paper-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
